#!/bin/bash
#
#set -x
#
RUNDIR=$(pwd)
#
cd $tmpdir
rm -f *
#pwd
#
#
#echo " copie des fichiers ecoclimap "
#
ln -s $RUNDIR/*.bin .
ln -s $RUNDIR/PGD* .
ln -s $RUNDIR/PREP* .
#
ln -s $RUNDIR/SST_SIC .
ln -s $RUNDIR/CANARI .
ln -s $RUNDIR/clim_isba .
ln -s $RUNDIR/FG_OI_MAIN .
ln -s $RUNDIR/fort.61 .
