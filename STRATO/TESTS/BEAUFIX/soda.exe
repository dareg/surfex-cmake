ln -s $RUNDIR/CANARI_NATURE*.DAT .
ln -s $RUNDIR/BGROUNDin* .
#
cp -f $RUNDIR/OPTIONS.nam .
#
#echo " copie de l'executable "
#
cp -f $RUNDIR/soda$1.exe soda.exe
#
MPI_TASKS=1
#
#export KMP_NUM_THREADS=1
export OMP_NUM_THREADS=1
#
#export KMP_STACKSIZE=13m
#export KMP_MONITOR_STACKSIZE=13m
export OMP_STACKSIZE=13m
#
#export DR_HOOK=1
#export DR_HOOK_OPT=prof
#
ulimit -s unlimited
#
srun -N1 -n${MPI_TASKS} -c${OMP_NUM_THREADS} ./soda.exe
#
#ls -l
#
#cp drhook.* $RUNDIR
mv -f LISTING_SODA*.txt $RUNDIR
#cp log* $RUNDIR

mv -f SURFOUT.* $RUNDIR
